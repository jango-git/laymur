{
  "name": "laymur",
  "version": "0.31.0",
  "description": "Constraint-based UI library for Three.js mobile advertisements",
  "keywords": [
    "ui",
    "three.js",
    "mobile",
    "ads",
    "constraints",
    "layout",
    "typescript"
  ],
  "homepage": "https://github.com/jango-git/laymur#readme",
  "bugs": {
    "url": "https://github.com/jango-git/laymur/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jango-git/laymur.git"
  },
  "license": "MIT",
  "author": "jango",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./particles": {
      "types": "./dist/particles/index.d.ts",
      "import": "./dist/particles/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && node scripts/build.mjs",
    "lint": "eslint src",
    "format": "prettier --write . && eslint src --fix",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@lume/kiwi": "^0.4.4",
    "fast-simplex-noise": "^4.0.0",
    "ferrsign": "^0.0.6",
    "three": ">=0.157.0 <0.188.0"
  },
  "peerDependenciesMeta": {
    "fast-simplex-noise": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/three": "^0.157.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3"
  }
}
